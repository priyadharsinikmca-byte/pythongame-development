import pgzrun

WIDTH = 800
HEIGHT = 600

score = 0
current = 0
questions = []

with open("questions.txt", "r") as file:
    for line in file:
        q = line.strip().split("|")
        questions.append(q)

option1 = Rect((150, 300), (220, 60))
option2 = Rect((430, 300), (220, 60))


def draw():
    screen.clear()
    screen.fill("black")

    if current < len(questions):
        q = questions[current]

        screen.draw.text(
            q[0],
            center=(400, 150),
            fontsize=35,
            color="white"
        )

        screen.draw.filled_rect(option1, "green")
        screen.draw.filled_rect(option2, "orange")

        screen.draw.text(
            q[1],
            center=option1.center,
            fontsize=25,
            color="white"
        )

        screen.draw.text(
            q[2],
            center=option2.center,
            fontsize=25,
            color="white"
        )

        screen.draw.text(
            "Score: " + str(score),
            (20, 20),
            fontsize=30,
            color="red"
        )

    else:
        screen.draw.text(
            "Quiz Finished!",
            center=(400, 200),
            fontsize=50,
            color="white"
        )

        screen.draw.text(
            "Final Score: " + str(score),
            center=(400, 280),
            fontsize=40,
            color="blue"
        )


def on_mouse_down(pos):
    global current, score

    if current >= len(questions):
        return

    q = questions[current]

    print("Mouse clicked:", pos)

    if option1.collidepoint(pos):
        print("Option 1 clicked")

        if q[1].strip() == q[3].strip():
            score += 1

        current += 1

    elif option2.collidepoint(pos):
        print("Option 2 clicked")

        if q[2].strip() == q[3].strip():
            score += 1

        current += 1

    if current == len(questions):
        with open("score.txt", "w") as file:
            file.write("Final Score: " + str(score))


pgzrun.go()
