import pygame
import time 

pygame.init()
screen = pygame.display.set_mode((600,700))
pygame.display.set_caption("Birthday Animations")
font = pygame.font.SysFont("arial", 50)
small_font = pygame.font.SysFont("arial", 30) 
start_time = time.time()
page = 1
running = True
while running:
    screen.fill("blue")
    current_time = time.time() - start_time
    if current_time:
        page = 2
    if page == 1:
        text = font.render("Happy Birthday",True,"black")
        screen.blit(text,(180,175))
        message = small_font("Have a wonderful day",True,"black")
        screen.blit(message,(190,175))
    else:
        text = font.render("HAPPY BIRTHDAY!", True, "blue")
        screen.blit(text, (200, 150))

        message = small_font.render("Wishing you lots of happiness!", True, "purple")
        screen.blit(message, (180, 250))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    pygame.display.update()

pygame.quit()

 
